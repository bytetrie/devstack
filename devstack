#!/usr/bin/env bash
# devstack launcher: picks a Python >= 3.11 (needed for tomllib) and runs devstack.py.
# pyenv/conda shims often put an older python3 first on PATH, so the system
# interpreter is tried before the PATH one. Override with DEVSTACK_PYTHON=/path/to/python.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

candidates=()
if [[ -n "${DEVSTACK_PYTHON:-}" ]]; then candidates+=("$DEVSTACK_PYTHON"); fi
candidates+=(/usr/bin/python3 python3.13 python3.12 python3.11 python3)

for py in "${candidates[@]}"; do
  if command -v "$py" >/dev/null 2>&1 &&
    "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    exec "$py" "$here/devstack.py" "$@"
  fi
done

echo "devstack: needs Python >= 3.11 (for tomllib), none found." >&2
echo "Install it with: sudo apt install python3   (or set DEVSTACK_PYTHON)" >&2
exit 3
