# GENERATED by devstack (stack @@STACK@@) from templates/system/runner@.service.
# One job of runner "@@NAME@@", started by @@UNIT@@.socket for each connection.
# Runners are for tools that need the internet or parse untrusted files (fetchers,
# yt-dlp, ffmpeg). They run as @@RUNNER_USER@@ with the "internet" egress profile:
# public internet + DNS, no loopback, no private ranges, no host. They get no
# secrets (no EnvironmentFile=) and can't read app data: only incoming/ is
# writable, and the app must treat what lands there as untrusted input.
[Unit]
Description=@@STACK@@ runner @@NAME@@ job %i
After=devstack-egress.service
Requires=devstack-egress.service

[Service]
ExecStart=@@COMMAND@@
WorkingDirectory=@@PROJECT@@
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=NODE_ENV=production INCOMING_DIR=@@INCOMING@@

User=@@RUNNER_USER@@
Group=@@RUNNER_USER@@
NoNewPrivileges=yes

# Limits: one job can't take the machine down or run forever.
MemoryMax=@@MEMORY_MAX@@
RuntimeMaxSec=@@RUNTIME_MAX@@

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=@@PROJECT@@
InaccessiblePaths=-@@PROJECT@@/.git
@@INCOMING_LINES@@
# Files left in incoming/: owner rw, group (the app and the dev user) read.
UMask=0027

ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

CapabilityBoundingSet=
AmbientCapabilities=

# Network: egress profile "internet" in /etc/devstack/egress.nft (matched on this uid).
RestrictAddressFamilies=AF_INET AF_INET6

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
