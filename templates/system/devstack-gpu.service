# GENERATED by devstack (stack @@STACK@@) from templates/system/devstack-gpu.service.
# Hides the GPU device nodes at boot, before any login or service, so only
# services with gpu = true (container.services) can open them. See
# /usr/local/sbin/devstack-gpu-hide. GPU services Require= this unit: if it
# fails, they don't start.
[Unit]
Description=devstack: GPU device nodes for GPU services only
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target ssh.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/devstack-gpu-hide

[Install]
WantedBy=sysinit.target
