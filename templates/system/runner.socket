# GENERATED by devstack (stack @@STACK@@) from templates/system/runner.socket.
# Runner "@@NAME@@": every connection to 127.0.0.1:@@PORT@@ starts one job
# (@@UNIT@@@<n>.service) with the connection as its stdin/stdout. Closing the
# connection ends the job. Change [[app.runners]] in devstack.toml and re-run
# `devstack up --redo isolation`.
[Unit]
Description=@@STACK@@ runner @@NAME@@ (127.0.0.1:@@PORT@@)

[Socket]
ListenStream=127.0.0.1:@@PORT@@
Accept=yes
MaxConnections=@@MAX_CONNECTIONS@@

[Install]
WantedBy=sockets.target
