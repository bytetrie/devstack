#!/usr/sbin/nft -f
# GENERATED by devstack (stack @@STACK@@) from templates/system/egress.nft.
# Per-service egress profiles, matched on the socket owner's uid. Loaded by
# devstack-egress.service; the app and runner units Require= it, so they don't
# start without it. Users without a line below (you, ssh, VSCode, agents, Caddy,
# Postgres) are not restricted here; the incus ACL on the host keeps the whole
# container off the host and the LAN.
#
# Own table, replaced atomically on every load (the first line makes the delete
# safe when the table doesn't exist yet). Never `flush ruleset`: that would also
# wipe ufw's rules.
table inet devstack_egress
delete table inet devstack_egress

table inet devstack_egress {
	# Never reachable from the "internet" profiles: loopback, private and link-local
	# ranges, CGNAT, multicast/reserved, NAT64 and v4-mapped forms.
	set blocked4 {
		type ipv4_addr; flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
			     172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}
	set blocked6 {
		type ipv6_addr; flags interval
		elements = { ::/127, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7, fe80::/10, ff00::/8 }
	}

	chain out {
		type filter hook output priority 0; policy accept;
		# Replies on connections that someone else opened (Caddy -> app, a client ->
		# a runner socket) and connections a profile already allowed.
		ct state established,related accept
@@USER_RULES@@
	}

	# app.profile = "local": loopback only (Caddy, Postgres), and no DNS, because
	# the resolver would forward queries to the outside (a DNS tunnel).
	chain local_only {
		meta l4proto { tcp, udp } th dport 53 reject
		oif "lo" accept
		reject
	}

	# app.profile = "internet": loopback plus the public internet, and DNS through the
	# configured resolver (which may sit on the bridge gateway, a private address).
	chain local_internet {
		oif "lo" accept
@@RESOLVER_RULES@@
		ip daddr @blocked4 reject
		ip6 daddr @blocked6 reject
		accept
	}

	# Runners: DNS through the configured resolver, then the public internet only.
	chain internet_only {
@@RESOLVER_RULES@@
		ip daddr @blocked4 reject
		ip6 daddr @blocked6 reject
		oif "lo" reject
		accept
	}
}
