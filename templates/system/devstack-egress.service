# Not nftables.service: Debian's /etc/nftables.conf starts with `flush ruleset`,
# which would also wipe ufw's rules.
[Unit]
Description=devstack egress profiles (nftables table inet devstack_egress)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/devstack/egress.nft
ExecReload=/usr/sbin/nft -f /etc/devstack/egress.nft

[Install]
