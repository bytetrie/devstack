#!/bin/bash
# GENERATED by devstack (stack @@STACK@@) from templates/system/devstack-sync.
# Installed root-owned at /usr/local/sbin/devstack-sync, outside the project.
#
# The dev user's only root command (sudoers: /etc/sudoers.d/devstack-@@STACK@@).
# It does a fixed set of things and nothing else: no other arguments, no shell
# passthrough. Root never opens a file the dev user controls: the package list
# comes in on stdin, so a symlink in the project can't make it read anything the
# user couldn't already read.
#
#   sudo devstack-sync packages < infra/apt-packages.txt   install what's missing
#   devstack-sync check-packages < infra/apt-packages.txt  validate only (no root)
#   sudo devstack-sync restart app | restart runners | restart services
#   sudo devstack-sync validate caddy                      check the Caddyfiles, change nothing
#   sudo devstack-sync reload caddy                        validate, then reload
#   sudo devstack-sync status
#
# Everything else (runners, services, egress profiles, app data, mounts, apt repos,
# sudo, GPU access, host ACL exceptions) is applied from the host by `devstack up`.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022
cd /

app_unit=@@APP_UNIT@@
runner_sockets=(@@RUNNER_SOCKETS@@)
service_units=(@@SERVICE_UNITS@@)
gpu_unit=@@GPU_UNIT@@
max_input=65536
# Debian package names, minus a trailing '-': `apt-get install foo-` REMOVES foo.
name_rx='^[a-z0-9][a-z0-9+.-]*[a-z0-9+]$'

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

need_root() {
  [ "$(id -u)" = 0 ] || { echo "devstack-sync $1: run it with sudo" >&2; exit 1; }
}

# Package names from stdin: one per line, '#' starts a comment, blank lines ignored.
read_names() {
  local data line name extra bad=0
  data=$(head -c "$((max_input + 1))")
  if [ "${#data}" -gt "$max_input" ]; then
    echo "package list is larger than $max_input bytes" >&2
    exit 1
  fi
  names=()
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    name=; extra=
    read -r name extra <<<"$line" || true
    [ -n "$name" ] || continue
    if [ -n "$extra" ] || ! [[ $name =~ $name_rx ]]; then
      echo "invalid package name: $(printf '%q' "$line")" >&2
      bad=1
      continue
    fi
    names+=("$name")
  done <<<"$data"
  [ "$bad" = 0 ] || { echo "nothing was installed" >&2; exit 1; }
}

installed() {
  [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]
}

policy=/usr/sbin/policy-rc.d
policy_saved=

restore_policy() {
  if [ -n "$policy_saved" ]; then mv -f "$policy_saved" "$policy"; else rm -f "$policy"; fi
}

cmd_packages() {
  need_root packages
  read_names
  local n missing=()
  for n in "${names[@]}"; do
    installed "$n" || missing+=("$n")
  done
  if [ "${#missing[@]}" -eq 0 ]; then
    echo "all ${#names[@]} listed packages are installed"
    return 0
  fi
  apt-get update -q
  # Exact names only: for an unknown name containing '.', apt-get would fall back to
  # treating it as a pattern and install everything that matches.
  local known
  known=$(apt-cache pkgnames)
  for n in "${missing[@]}"; do
    grep -qxF -- "$n" <<<"$known" || { echo "not a package in the configured apt sources: $n" >&2; exit 1; }
  done

  local before after new p f unit units=()
  before=$(dpkg-query -W -f='${Package}\n' | sort)
  # Packages may not start services while they install ...
  if [ -e "$policy" ]; then policy_saved=$(mktemp); cp -a "$policy" "$policy_saved"; fi
  trap restore_policy EXIT
  printf '#!/bin/sh\n# devstack-sync: packages may not start services\nexit 101\n' >"$policy"
  chmod 755 "$policy"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "${missing[@]}"
  restore_policy
  trap - EXIT
  after=$(dpkg-query -W -f='${Package}\n' | sort)
  new=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))

  # ... and don't get to run them later either: a long-running root service needs the
  # host's approval (a devstack change), not a line in a project file.
  for p in $new; do
    while IFS= read -r f; do
      case $f in
        /lib/systemd/system/*.service | /lib/systemd/system/*.socket | /lib/systemd/system/*.timer | \
        /lib/systemd/system/*.path | /usr/lib/systemd/system/*.service | /usr/lib/systemd/system/*.socket | \
        /usr/lib/systemd/system/*.timer | /usr/lib/systemd/system/*.path)
          units+=("${f##*/}") ;;
      esac
      if [ -f "$f" ] && { [ -u "$f" ] || [ -g "$f" ]; }; then
        echo "warning: $p installs a setuid/setgid file: $f" >&2
        logger -t devstack-sync "setuid/setgid file from $p: $f" || true
      fi
    done < <(dpkg-query -L "$p" 2>/dev/null)
  done
  for unit in "${units[@]}"; do
    if systemctl mask --now "$unit" >/dev/null 2>&1; then
      echo "masked $unit (services from packages need the host: ask for it in devstack.toml)"
    else
      echo "warning: could not mask $unit" >&2
    fi
  done
  logger -t devstack-sync "installed: ${missing[*]}${new:+ (new packages: $(echo $new))}${units[*]:+; masked: ${units[*]}}" || true
  echo "installed: ${missing[*]}"
}

cmd_check() {
  read_names
  [ "${#names[@]}" -eq 0 ] || printf '%s\n' "${names[@]}"
}

cmd_restart() {
  need_root restart
  case $1 in
    app) systemctl restart "$app_unit" ;;
    runners)
      if [ "${#runner_sockets[@]}" -eq 0 ]; then echo "no runners configured"; return 0; fi
      systemctl restart "${runner_sockets[@]}" ;;
    services)
      if [ "${#service_units[@]}" -eq 0 ]; then echo "no services configured"; return 0; fi
      systemctl restart "${service_units[@]}" ;;
    *) usage ;;
  esac
}

validate_caddy() {
  # As caddy, not root: the Caddyfile is the dev user's, and a parse error would
  # otherwise print the first token of any file root can read (`import /etc/shadow`).
  # caddy can read nothing the dev user may not already (its intermediate key is an
  # accepted exposure: SECURITY.md). Needs root at all only for that key.
  runuser -u caddy -- caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
}

cmd_validate_caddy() {
  need_root validate
  validate_caddy
}

cmd_reload_caddy() {
  need_root reload
  validate_caddy
  systemctl reload caddy
}

cmd_status() {
  need_root status
  local u
  for u in devstack-egress.service ${gpu_unit:+"$gpu_unit"} "$app_unit" caddy.service "${runner_sockets[@]}" \
    "${service_units[@]}"; do
    printf '%-40s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"
  done
  echo
  echo "egress profiles (uid -> profile):"
  nft list chain inet devstack_egress out 2>/dev/null | grep -E 'skuid' || echo "  not loaded"
  echo
  echo "last syncs:"
  journalctl -t devstack-sync -n 5 --no-pager -o short-iso 2>/dev/null || true
}

[ $# -ge 1 ] || usage
case "$1:$#" in
  packages:1) cmd_packages ;;
  check-packages:1) cmd_check ;;
  restart:2) case $2 in app | runners | services) cmd_restart "$2" ;; *) usage ;; esac ;;
  validate:2) [ "$2" = caddy ] || usage; cmd_validate_caddy ;;
  reload:2) [ "$2" = caddy ] || usage; cmd_reload_caddy ;;
  status:1) cmd_status ;;
  *) usage ;;
esac
