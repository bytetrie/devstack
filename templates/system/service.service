# GENERATED by devstack (stack @@STACK@@) from templates/system/service.service.
# Service "@@NAME@@" (container.services): the download
#   @@URL@@
# checked against sha256 @@SHA256@@ and installed root-owned in @@DIR@@,
# so nothing the container user can edit runs as @@USER@@.
# Change devstack.toml and re-run `devstack up --redo isolation`.
[Unit]
Description=@@STACK@@ service @@NAME@@
After=network.target devstack-egress.service@@GPU_UNIT@@
# No egress rules, no service: if the profile can't load, the service doesn't start.
Requires=devstack-egress.service@@GPU_UNIT@@

[Service]
ExecStart=@@DIR@@/@@COMMAND@@
WorkingDirectory=@@STATE_DIR@@
Environment=HOME=@@STATE_DIR@@
@@ENV_LINES@@

# Its own fixed uid (isolation.system_uid_base + 4 + its position in container.services):
# the egress profile matches on it. Not in the data or dev group: no app data, no token.
User=@@USER@@
Group=@@USER@@
NoNewPrivileges=yes
@@MEMORY_LINES@@

# Filesystem: read-only everywhere, the project and /home invisible. Writable: its
# own state folder ($HOME, $STATE_DIRECTORY; on the root disk, so a rebuild resets
# it) and the write_paths it was given.
StateDirectory=@@USER@@
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
InaccessiblePaths=-@@PROJECT@@
@@WRITE_LINES@@
UMask=0077

ProtectProc=invisible
@@DEVICE_LINES@@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

CapabilityBoundingSet=
AmbientCapabilities=

# Network: egress profile "@@PROFILE@@" in /etc/devstack/egress.nft (nftables,
# matched on this uid), not a setting here. AF_UNIX and AF_NETLINK for local
# plumbing (the NVIDIA persistence daemon's socket, interface lookups); neither
# leaves the container.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
