#!/bin/bash
# GENERATED by devstack (stack @@STACK@@) from templates/system/devstack-gpu.
# Installed root-owned at /usr/local/sbin/devstack-gpu-hide, run at boot by
# devstack-gpu.service (gpu.login_user = false).
#
# Hides the GPU device nodes from everything in the container: each node (or
# device folder) is bind-mounted into @@HIDE_DIR@@ (root only, 0700) and an
# inaccessible placeholder is mounted over the original. Services with
# gpu = true (container.services) get them back with BindPaths= in their own
# mount namespace; nothing else does.
#
# Why not owner/mode on the nodes: with nvidia.runtime they are the host's own
# nodes, bind-mounted in, world-writable and owned by a host uid the container
# can't change. Why this holds: the container user can't mknod, can't unmount
# the placeholder (in a user namespace of its own the mounts are locked), and
# can't reach a service's mount namespace (/proc/<pid>/root needs ptrace rights
# over another uid).
#
# Idempotent: a node already hidden is left alone, so restarting the unit hides
# nodes added since the last run.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077
shopt -s nullglob

hide=@@HIDE_DIR@@
install -d -m 0700 -o root -g root "$hide"
none_file=$hide/.none-file
none_dir=$hide/.none-dir
[ -f "$none_file" ] || : >"$none_file"
chmod 0000 "$none_file"
install -d -m 0000 "$none_dir"

hidden=()
for p in /dev/nvidia* /dev/kfd /dev/dri; do
  [ ! -L "$p" ] || continue
  n=${p#/dev/}
  if findmnt -rn --mountpoint "$hide/$n" >/dev/null; then continue; fi
  # The copy is made private before the original is covered: /dev is a shared
  # mount, so a copy left in its peer group would get the placeholder too.
  if [ -c "$p" ]; then
    : >"$hide/$n"
    mount --bind "$p" "$hide/$n"
    mount --make-private "$hide/$n"
    mount --bind "$none_file" "$p"
  elif [ -d "$p" ]; then
    install -d -m 0700 "$hide/$n"
    mount --rbind "$p" "$hide/$n"
    mount --make-rprivate "$hide/$n"
    mount --bind "$none_dir" "$p"
  else
    continue
  fi
  hidden+=("$n")
done
if [ "${#hidden[@]}" -gt 0 ]; then
  logger -t devstack-gpu "hidden from the container: ${hidden[*]}" || true
  echo "hidden: ${hidden[*]}"
else
  echo "nothing new to hide"
fi
